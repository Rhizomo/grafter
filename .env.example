# ── OIDC login flow ───────────────────────────────────────────────────────────
# The client users authenticate as (browser-facing).
OIDC_ISSUER=https://authentication.example.com/realms/myrealm
OIDC_CLIENT_ID=grafter
OIDC_CLIENT_SECRET=<grafter client secret from Keycloak>
OIDC_REDIRECT_URI=https://grafter.example.com/auth/callback

# ── Keycloak Admin API ─────────────────────────────────────────────────────────
# A separate service-account client with realm-level read access.
# In production these should be DIFFERENT credentials from the OIDC client above.
KC_ADMIN_URL=https://authentication.example.com
KC_ADMIN_REALM=myrealm
KC_ADMIN_CLIENT_ID=grafter-admin
KC_ADMIN_CLIENT_SECRET=<grafter-admin service account secret from Keycloak>

# ── Roles ─────────────────────────────────────────────────────────────────────
IAM_ROLE_ADMIN=devops
IAM_ROLE_OPERATOR=martech_adtrace_devops_senior

# ── MinIO / S3 ────────────────────────────────────────────────────────────────
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=grafter
S3_ACCESS_KEY=<access key>
S3_SECRET_KEY=<secret key>

# ── Session ───────────────────────────────────────────────────────────────────
# Must be at least 32 bytes. Generate: openssl rand -hex 32
SESSION_SECRET=<random 64-char hex string>

# docker-compose: redis://redis:6379  |  local dev: redis://127.0.0.1:6379
REDIS_URL=redis://127.0.0.1:6379

# ── Emergency break-glass ─────────────────────────────────────────────────────
# If set, enables POST /emergency/promote to grant admin role without a session.
# Leave empty (or unset) to disable. Rate-limited to 3 attempts per IP per hour.
# Generate: openssl rand -hex 32
# EMERGENCY_TOKEN=

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
